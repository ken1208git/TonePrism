<Page
    x:Class="TonePrism.Manager.Shell.Records.RecordsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="#FF202020">

    <!-- (#464) 会期の記録 (responses/) を DB のゲーム情報と突き合わせて振り返る読み取り専用ページ。
         書き込みは一切しない。記録は取り直しの効かないデータなので、この画面から DB / responses を
         変更する API を足さないこと。
         注意: DataTemplate 内の TextBlock には Page.Resources の暗黙スタイルが届かず WPF 既定の黒文字に
         落ちるため、テンプレ内テキストは必ず明示 Foreground を付ける (DashboardPage と同じ罠)。 -->

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ECECEC" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FF2B2B2B" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18,15" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="CardHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ECECEC" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA0A6" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- 期間 / 指標 / 切り口の選択チップ。RadioButton を丸いタブに見せる。 -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="#FF333333" BorderBrush="#22FFFFFF"
                                BorderThickness="1" CornerRadius="14" Padding="13,5">
                            <TextBlock x:Name="Tx" Text="{TemplateBinding Content}"
                                       Foreground="#C2C7CC" FontSize="12" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF3C6FB4" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#FF5C93DC" />
                                <Setter TargetName="Tx" Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#55FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 概況タイル -->
        <DataTemplate x:Key="TileTemplate">
            <Border Background="#FF303030" BorderBrush="#1AFFFFFF" BorderThickness="1"
                    CornerRadius="8" Padding="16,13" Margin="0,0,12,12" MinWidth="152">
                <StackPanel>
                    <TextBlock Text="{Binding Value}" Foreground="#F2F2F2" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Label}" Foreground="#C2C7CC" FontSize="12" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding Sub}" Foreground="#8A9096" FontSize="10.5" Margin="0,1,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 汎用の横棒 1 行 (★内訳・時間分布) -->
        <DataTemplate x:Key="BarTemplate">
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="#C2C7CC" FontSize="11.5"
                           VerticalAlignment="Center" />
                <Border Grid.Column="1" Height="9" CornerRadius="4.5" HorizontalAlignment="Left"
                        VerticalAlignment="Center" Width="{Binding BarWidth}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FF3C6FB4" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Highlight}" Value="True">
                                    <Setter Property="Background" Value="#FF5C93DC" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="{Binding CountText}" Foreground="#ECECEC" FontSize="11.5" MinWidth="46" />
                    <TextBlock Text="{Binding PercentText}" Foreground="#8A9096" FontSize="10.5" MinWidth="42" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- メタ情報 1 行 -->
        <DataTemplate x:Key="MetaTemplate">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="#8A9096" FontSize="11.5" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#ECECEC" FontSize="11.5"
                           TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>

        <!-- コメント 1 件 -->
        <DataTemplate x:Key="CommentTemplate">
            <Border Background="#FF303030" BorderBrush="#1AFFFFFF" BorderThickness="1"
                    CornerRadius="6" Padding="12,9" Margin="0,0,0,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="{Binding RatingStars}" Foreground="#E0A03E" FontSize="12" />
                        <TextBlock Text="{Binding GameTitle}" Foreground="#C2C7CC" FontSize="11.5" Margin="10,0,0,0" />
                        <TextBlock Text="{Binding AtDisplay}" Foreground="#7C8288" FontSize="10.5" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding Text}" Foreground="#ECECEC" FontSize="12.5" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 切り口別 1 行 -->
        <DataTemplate x:Key="GroupTemplate">
            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="{Binding Key}" Foreground="#ECECEC" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding TopGameText}" Foreground="#7C8288" FontSize="10.5"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border Grid.Column="1" Height="10" CornerRadius="5" Background="#FF3C6FB4"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Width="{Binding BarWidth}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="{Binding PlaysText}" Foreground="#ECECEC" FontSize="12" MinWidth="62" />
                    <TextBlock Text="{Binding GamesText}" Foreground="#8A9096" FontSize="11" MinWidth="50" />
                    <TextBlock Text="{Binding RatingText}" Foreground="#C2C7CC" FontSize="11" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ゲーム 1 行。ヘッダをクリックすると詳細が開く (自前テンプレートの Expander)。 -->
        <DataTemplate x:Key="GameRowTemplate">
            <Border Background="#FF303030" BorderBrush="#1AFFFFFF" BorderThickness="1"
                    CornerRadius="8" Margin="0,0,0,8">
                <Expander Background="Transparent" BorderThickness="0">
                    <Expander.Style>
                        <Style TargetType="Expander">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Expander">
                                        <StackPanel>
                                            <!-- **Horizontal*Alignment を 2 つとも明示すること**。これが無いと行の中身が
                                                 希望幅に縮んで左寄せになり、見出し行と右側 4 指標の列が揃わない。
                                                 決定的だったのは HorizontalAlignment の方で、**WPF-UI の暗黙 ToggleButton スタイルが
                                                 左寄せを setter で当ててくる**ため (Template だけ差し替えても style setter は生き残る)。
                                                 レンダリングして目で見ないと気づけない種類のズレなので、外さないこと。 -->
                                            <ToggleButton x:Name="Head" Cursor="Hand" HorizontalContentAlignment="Stretch"
                                                          HorizontalAlignment="Stretch"
                                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="HeadBg" Background="Transparent" Padding="14,11"
                                                                HorizontalAlignment="Stretch">
                                                            <ContentPresenter HorizontalAlignment="Stretch" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="HeadBg" Property="Background" Value="#12FFFFFF" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="230" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="16" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding RankText}" Foreground="#7C8288"
                                                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />

                                                    <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Title}" Foreground="#F2F2F2" FontSize="13.5"
                                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <Border Background="#33FFFFFF" CornerRadius="4" Padding="5,0" Margin="8,1,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="{Binding Badge}" Foreground="#D8DDE2" FontSize="10" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding SubTitle}" Foreground="#7C8288" FontSize="10.5"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="92" Margin="0,0,10,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding MetricText}" Foreground="#F2F2F2"
                                                                       FontSize="15" FontWeight="SemiBold" />
                                                            <Border Background="#44A0783C" CornerRadius="4" Padding="5,0" Margin="7,3,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding IsReference, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="参考" Foreground="#E8C48A" FontSize="9.5" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding MetricSubText}" Foreground="#7C8288" FontSize="10" />
                                                    </StackPanel>

                                                    <Border Grid.Column="3" Height="10" CornerRadius="5" Background="#FF3C6FB4"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                                            Width="{Binding BarWidth}" />

                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PlaysText}" Foreground="#C2C7CC" FontSize="11.5" MinWidth="56" TextAlignment="Right" />
                                                        <TextBlock Text="{Binding RatingText}" Foreground="#C2C7CC" FontSize="11.5" MinWidth="58" TextAlignment="Right" />
                                                        <TextBlock Text="{Binding DurationText}" Foreground="#C2C7CC" FontSize="11.5" MinWidth="70" TextAlignment="Right" />
                                                        <TextBlock Text="{Binding ResponseRateText}" Foreground="#C2C7CC" FontSize="11.5" MinWidth="46" TextAlignment="Right" />
                                                    </StackPanel>

                                                    <TextBlock x:Name="Arrow" Grid.Column="5" Text="⌄" Foreground="#8A9096"
                                                               FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                </Grid>
                                            </ToggleButton>

                                            <ContentPresenter x:Name="Body" Visibility="Collapsed" />
                                        </StackPanel>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsExpanded" Value="True">
                                                <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="Arrow" Property="Text" Value="⌃" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Expander.Style>

                    <!-- 展開したときの中身 -->
                    <Border Background="#FF2A2A2A" CornerRadius="0,0,8,8" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="{Binding EmptyNote}" Foreground="#9AA0A6" FontSize="12" TextWrapping="Wrap"
                                       Visibility="{Binding HasEmptyNote, Converter={StaticResource BoolToVis}}" />

                            <Grid Visibility="{Binding HasPlays, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                    <TextBlock Text="評価の内訳" Foreground="#C2C7CC" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"
                                               Visibility="{Binding HasSurveys, Converter={StaticResource BoolToVis}}" />
                                    <ItemsControl ItemsSource="{Binding RatingBars}" ItemTemplate="{StaticResource BarTemplate}"
                                                  Visibility="{Binding HasSurveys, Converter={StaticResource BoolToVis}}" />

                                    <TextBlock Text="1回あたりのプレイ時間" Foreground="#C2C7CC" FontSize="12" FontWeight="SemiBold"
                                               Margin="0,14,0,8" />
                                    <ItemsControl ItemsSource="{Binding DurationBars}" ItemTemplate="{StaticResource BarTemplate}" />

                                    <TextBlock Text="遊ばれた時間帯" Foreground="#C2C7CC" FontSize="12" FontWeight="SemiBold"
                                               Margin="0,14,0,8" />
                                    <ItemsControl ItemsSource="{Binding HourBars}" ItemTemplate="{StaticResource BarTemplate}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="このゲームについて" Foreground="#C2C7CC" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding Meta}" ItemTemplate="{StaticResource MetaTemplate}" />

                                    <TextBlock Text="{Binding CommentsHeader}" Foreground="#C2C7CC" FontSize="12" FontWeight="SemiBold"
                                               Margin="0,16,0,8"
                                               Visibility="{Binding HasComments, Converter={StaticResource BoolToVis}}" />
                                    <ItemsControl ItemsSource="{Binding Comments}" ItemTemplate="{StaticResource CommentTemplate}"
                                                  Visibility="{Binding HasComments, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Expander>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel Margin="24,20,24,32">

                <!-- ===== ヘッダ ===== -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="記録" FontSize="22" FontWeight="SemiBold" Foreground="#F2F2F2" />
                        <TextBlock x:Name="StatusText" Foreground="#8A9096" FontSize="11.5" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button x:Name="ExportButton" Content="書き出し…" Click="Export_Click"
                                   Padding="12,5" Margin="0,0,8,0" />
                        <ui:Button x:Name="RefreshButton" Content="更新" Appearance="Primary" Click="Refresh_Click"
                                   Padding="14,5" />
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="DayFilterPanel" Orientation="Horizontal" Margin="0,10,0,16" />

                <!-- ===== 読み込み中 / 空 ===== -->
                <Border x:Name="LoadingPanel" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <ui:ProgressRing IsIndeterminate="True" Width="22" Height="22" Margin="0,0,12,0" />
                        <TextBlock Text="記録を読み込んでいます…" Foreground="#C2C7CC" FontSize="12.5" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border x:Name="EmptyPanel" Style="{StaticResource Card}" Visibility="Collapsed">
                    <TextBlock x:Name="EmptyText" Foreground="#C2C7CC" FontSize="12.5" TextWrapping="Wrap" />
                </Border>

                <StackPanel x:Name="ContentRoot">

                    <!-- ===== 概況 ===== -->
                    <ItemsControl x:Name="TilesList" ItemTemplate="{StaticResource TileTemplate}" Margin="0,0,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- ===== ★3 の注意 (#463) ===== -->
                    <Border x:Name="CaveatCard" Background="#FF3A3323" BorderBrush="#55E0A03E" BorderThickness="1"
                            CornerRadius="8" Padding="18,15" Margin="0,0,0,14" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="CaveatHeadline" Foreground="#F0C97C" FontSize="13.5" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,0,0,8" />
                            <ItemsControl x:Name="CaveatList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="#DCD2BC" FontSize="11.5"
                                                   TextWrapping="Wrap" Margin="0,0,0,5" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ===== ゲーム別ランキング ===== -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="ゲーム別" Style="{StaticResource CardHeader}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,10">
                                <RadioButton x:Name="MetricPlays" Style="{StaticResource Chip}" Content="遊ばれた回数"
                                             GroupName="metric" IsChecked="True" Checked="Metric_Changed" />
                                <RadioButton x:Name="MetricRating" Style="{StaticResource Chip}" Content="平均★"
                                             GroupName="metric" Checked="Metric_Changed" />
                                <RadioButton x:Name="MetricDuration" Style="{StaticResource Chip}" Content="熱中度（プレイ時間）"
                                             GroupName="metric" Checked="Metric_Changed" />
                                <RadioButton x:Name="MetricRate" Style="{StaticResource Chip}" Content="アンケート回答率"
                                             GroupName="metric" Checked="Metric_Changed" />
                            </StackPanel>
                            <TextBlock x:Name="RankingCaption" Style="{StaticResource Caption}" />

                            <!-- 一覧の見出し (行の右側 4 指標に対応) -->
                            <Grid Margin="0,0,30,6">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="回数" Foreground="#7C8288" FontSize="10.5" MinWidth="56" TextAlignment="Right" />
                                    <TextBlock Text="平均★" Foreground="#7C8288" FontSize="10.5" MinWidth="58" TextAlignment="Right" />
                                    <TextBlock Text="中央時間" Foreground="#7C8288" FontSize="10.5" MinWidth="70" TextAlignment="Right" />
                                    <TextBlock Text="回答率" Foreground="#7C8288" FontSize="10.5" MinWidth="46" TextAlignment="Right" />
                                    <TextBlock Text="" MinWidth="16" />
                                </StackPanel>
                            </Grid>

                            <ItemsControl x:Name="GamesList" ItemTemplate="{StaticResource GameRowTemplate}" />
                        </StackPanel>
                    </Border>

                    <!-- ===== 時間帯 ===== -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="時間帯ごとの盛り上がり" Style="{StaticResource CardHeader}" />
                            <TextBlock Text="15 分ごとのプレイ数です。山が高いほど、その時間に人が集まっていました。"
                                       Style="{StaticResource Caption}" />
                            <StackPanel x:Name="TimelinePanel" />
                        </StackPanel>
                    </Border>

                    <!-- ===== 全体アンケート ===== -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="全体アンケート" Style="{StaticResource CardHeader}" />
                            <TextBlock x:Name="OverallCaption" Style="{StaticResource Caption}" />
                            <ItemsControl x:Name="OverallBars" ItemTemplate="{StaticResource BarTemplate}" />
                        </StackPanel>
                    </Border>

                    <!-- ===== 切り口別 ===== -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="切り口べつに見る" Style="{StaticResource CardHeader}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,10">
                                <RadioButton x:Name="AxisGenre" Style="{StaticResource Chip}" Content="ジャンル"
                                             GroupName="axis" IsChecked="True" Checked="Axis_Changed" />
                                <RadioButton x:Name="AxisDifficulty" Style="{StaticResource Chip}" Content="難易度"
                                             GroupName="axis" Checked="Axis_Changed" />
                                <RadioButton x:Name="AxisGrade" Style="{StaticResource Chip}" Content="期生"
                                             GroupName="axis" Checked="Axis_Changed" />
                                <RadioButton x:Name="AxisDeveloper" Style="{StaticResource Chip}" Content="制作者"
                                             GroupName="axis" Checked="Axis_Changed" />
                            </StackPanel>
                            <TextBlock Text="1 本のゲームが複数のジャンル・複数の制作者に属することがあるため、合計は全体と一致しません。平均★は回答 1 件ずつで重み付けしています。"
                                       Style="{StaticResource Caption}" />
                            <ItemsControl x:Name="GroupsList" ItemTemplate="{StaticResource GroupTemplate}" />
                        </StackPanel>
                    </Border>

                    <!-- ===== コメント ===== -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="もらったコメント" Style="{StaticResource CardHeader}" />
                            <TextBlock x:Name="CommentsCaption" Style="{StaticResource Caption}" />
                            <ItemsControl x:Name="CommentsList" ItemTemplate="{StaticResource CommentTemplate}" />
                        </StackPanel>
                    </Border>

                    <!-- ===== 注記 ===== -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="この数字の読み方" Style="{StaticResource CardHeader}" />
                            <ItemsControl x:Name="NotesList" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="#9AA0A6" FontSize="11.5"
                                                   TextWrapping="Wrap" Margin="0,0,0,6" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
